# Copy to .env and set your keys (never commit .env)
GROQ_API_KEY=

# Vector Database and Embeddings Configuration
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=128
EMBED_BATCH_SLEEP_S=1.0

# LLM Chat Model Configuration
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
ANALYSIS_SAMPLE_CAP=450
UNMET_NEEDS_SAMPLE_CAP=300
ANALYSIS_BATCH_SIZE=20
GROQ_CALL_SLEEP_S=0.5

# Ingestion Settings
LOOKBACK_WEEKS=10
INCREMENTAL_OVERLAP_DAYS=3
PACKAGE_NAME=com.myntra.android
APP_STORE_ID=907394059
MIN_WORD_COUNT=6

# MouthShut ingestion (opt-in source — pass --sources ...,mouthshut).
# Needs Playwright+Chromium (see requirements.txt) to pass Cloudflare's JS
# challenge; plain requests/curl get a 403.
MOUTHSHUT_PRODUCT_SLUG=myntra-reviews-925076140
MOUTHSHUT_MAX_PAGES=50

# Grounded RAG Chatbot Settings
RAG_USE_GROQ=true
RAG_FALLBACK=true
RAG_TOP_K=8
RAG_FETCH_K=40
RAG_MMR_LAMBDA=0.7
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_ANSWER_TOKENS=768

# Toggle Groq-based LLM segment classification (default: false, runs local heuristics)
USE_GROQ_SEGMENTATION=false
SERPAPI_API_KEY=

# Groq free-tier throttle (batch analysis + live chat share this budget)
GROQ_RPM_LIMIT=28
GROQ_TPM_LIMIT=11000
GROQ_THROTTLE=true
GROQ_RPD_LIMIT=1000
GROQ_TPD_LIMIT=500000
GROQ_LIVE_CHAT_RESERVED_PCT=0.25
GROQ_BUDGET_STATE_FILE=groq_budget_state.json

# Opportunity-area analysis
ANALYSIS_PROMPT_VERSION=wishlist_v1
OPPORTUNITY_SAMPLE_CAP_PER_AREA=40
