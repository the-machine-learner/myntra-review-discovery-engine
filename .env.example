# Copy to .env and set your keys (never commit .env)
GROQ_API_KEY=

# Vector Database and Embeddings Configuration
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=128
EMBED_BATCH_SLEEP_S=1.0

# LLM Chat Model Configuration
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
ANALYSIS_SAMPLE_CAP=450
UNMET_NEEDS_SAMPLE_CAP=300
ANALYSIS_BATCH_SIZE=20
GROQ_CALL_SLEEP_S=0.5

# Ingestion Settings
LOOKBACK_WEEKS=10
INCREMENTAL_OVERLAP_DAYS=3
PACKAGE_NAME=com.myntra.android
APP_STORE_ID=907394059
MIN_WORD_COUNT=6

# Reddit API Credentials (Optional - falls back to Apify, then local seeding)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT="macos:com.discoveryengine.scraper:v1.0.0 (by /u/prodkins)"

# Apify Reddit Scraper (used when REDDIT_CLIENT_ID/SECRET are absent).
# Pay-per-Apify-usage actor, no monthly rental — fits a Free-tier Apify account.
APIFY_API_TOKEN=
APIFY_REDDIT_ACTOR_ID=spry_wholemeal/reddit-scraper
APIFY_MAX_POSTS_PER_QUERY=40
APIFY_MAX_COMMENTS_PER_POST=10

# Grounded RAG Chatbot Settings
RAG_USE_GROQ=true
RAG_FALLBACK=true
RAG_TOP_K=8
RAG_FETCH_K=40
RAG_MMR_LAMBDA=0.7
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_ANSWER_TOKENS=768

# Toggle Groq-based LLM segment classification (default: false, runs local heuristics)
USE_GROQ_SEGMENTATION=false
SERPAPI_API_KEY=
