# Copy to .env and set your keys (never commit .env)
GROQ_API_KEY=

# Vector Database and Embeddings Configuration
EMBEDDING_BACKEND=local
LOCAL_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_BATCH_SIZE=128
EMBED_BATCH_SLEEP_S=1.0

# LLM Chat Model Configuration
GROQ_CHAT_MODEL=llama-3.3-70b-versatile
ANALYSIS_SAMPLE_CAP=450
UNMET_NEEDS_SAMPLE_CAP=300
ANALYSIS_BATCH_SIZE=20
GROQ_CALL_SLEEP_S=0.5

# Ingestion Settings
LOOKBACK_WEEKS=10
INCREMENTAL_OVERLAP_DAYS=3
PACKAGE_NAME=com.myntra.android
APP_STORE_ID=907394059
MIN_WORD_COUNT=6

# Grounded RAG Chatbot Settings
RAG_USE_GROQ=true
RAG_FALLBACK=true
RAG_TOP_K=8
RAG_FETCH_K=40
RAG_MMR_LAMBDA=0.7
RAG_SIMILARITY_THRESHOLD=0.30
RAG_MAX_ANSWER_TOKENS=768

# Toggle Groq-based LLM segment classification (default: false, runs local heuristics)
USE_GROQ_SEGMENTATION=false
SERPAPI_API_KEY=
